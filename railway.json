{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "Dockerfile",
    "buildpacks": [],
    "pkgs": []
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckPort": 8000,
    "startCommand": "python -m memu.api",
    "volumes": {
      "/data/cache": {}
    }
  },
  "env": {
    "MEMU_API_KEY": {
      "required": true
    },
    "DATABASE_URL": {
      "required": true
    }
  }
}

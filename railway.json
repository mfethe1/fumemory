{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "Dockerfile",
    "buildpacks": [],
    "pkgs": []
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckPort": 8000,
    "startCommand": "python -m memu.api",
    "volumes": {
      "/data/cache": {}
    }
  },
  "env": {
    "MEMU_API_KEY": {
      "required": true
    },
    "DATABASE_URL": {
      "required": true
    },
    "EMBEDDING_API_BASE": {
      "required": false,
      "description": "Canonical embedding provider base URL (e.g. https://api.openai.com). EMBEDDING_BASE_URL is a deprecated alias."
    },
    "EMBEDDING_MODEL": {
      "required": false,
      "description": "Embedding model name. Default: text-embedding-3-small"
    },
    "EMBEDDING_DIMS": {
      "required": false,
      "description": "Embedding vector dimension. Default: 1536. Must match the model and the schema."
    }
  }
}

# fumemory — Environment Configuration
#
# Copy to .env and fill in your values.
# NEVER commit .env to git — only .env.example

# NATS
# Local dev: point NATS_LOCAL_URL at your local broker.
# Railway/cloud: leave NATS_LOCAL_URL unset and set NATS_RAILWAY_URL to your Railway TCP endpoint.
NATS_LOCAL_URL=nats://localhost:4222
NATS_RAILWAY_URL=
# Example: nats://<railway-nats-host>:<railway-nats-port>
# NATS_AUTH_TOKEN=  # Set when zero-trust RBAC is enabled

# Postgres (memU)
DATABASE_URL=postgresql://memu:memu@localhost:5432/memu
MEMU_API_KEY=memu-dev-key

# Embeddings
# Production should use a hosted endpoint; localhost is for local dev only.
# OPENAI_API_KEY=your-openai-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMS=4096

# OpenAI (for RAG chat + hydration summarization)
OPENAI_API_KEY=

# Temporal (required only if you want /memories/async and /search/async)
TEMPORAL_HOST=
TEMPORAL_TLS=false

# Warden (container control plane)
WARDEN_SECRET=  # HMAC secret for signed respawn requests — CHANGE IN PRODUCTION
WARDEN_MAX_CONTAINERS=10
WARDEN_WARM_POOL_MODE=cold
WARDEN_GATEWAY_IMAGE=fumemory-gateway:latest

# WebSocket Bridge
WS_BRIDGE_PORT=8001

# Hardening
EVENT_RETENTION_DAYS=30
MAX_CHECKPOINTS_PER_TASK=10
HYDRATION_TIMEOUT_S=15
MEMORY_THRESHOLD_PCT=80.0

# Notion integration
NOTION_API_KEY=your-notion-integration-token
# Get from: https://www.notion.so/my-integrations

# Agent identity (for task claiming)
AGENT_ID=rosie
# rosie | lenny | macklemore | winnie | any
POLL_INTERVAL=60
# seconds between task polls

# fumemory — NATS Cluster Environment Configuration
#
# Local NATS (primary): Lenny's Linux box
# Railway NATS (fallback): deploy via infra/railway-nats/
#
# Update NATS_LOCAL_URL once Lenny confirms the network-reachable address.
# If running on the same machine, localhost:4222 works.

# NATS
NATS_LOCAL_URL=nats://localhost:4222
NATS_RAILWAY_URL=nats://nats.railway.internal:4222
# NATS_AUTH_TOKEN=  # Set when zero-trust RBAC is enabled

# Postgres (memU)
DATABASE_URL=postgresql://memu:memu@localhost:5432/memu
MEMU_API_KEY=memu-dev-key

# Embeddings
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIMS=4096

# OpenAI (for RAG chat)
OPENAI_API_KEY=

# WebSocket Bridge
WS_BRIDGE_PORT=8001

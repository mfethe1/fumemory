# fumemory — Environment Configuration
#
# Copy to .env and fill in your values.
# NEVER commit .env to git — only .env.example

# NATS
# Local dev: point NATS_LOCAL_URL at your local broker.
# Railway/cloud: leave NATS_LOCAL_URL unset and set NATS_RAILWAY_URL to your Railway TCP endpoint.
# Backwards compatibility: single-endpoint workers still accept NATS_URL, but the shared contract is
# NATS_LOCAL_URL + NATS_RAILWAY_URL so every component resolves the same primary/fallback pair.
NATS_LOCAL_URL=nats://localhost:4222
NATS_RAILWAY_URL=
# Example: nats://<railway-nats-host>:<railway-nats-port>
# NATS_URL=nats://localhost:4222
# NATS_AUTH_TOKEN=  # Set when zero-trust RBAC is enabled

# NATS Authentication (for Synadia Cloud / NGS)
# Set ONE of these when connecting to a secured NATS cluster.
# NATS_CREDS_FILE=/path/to/nats.creds
# NATS_NKEY_SEED=SUAM...

# Postgres (memU)
DATABASE_URL=postgresql://memu:memu@localhost:5432/memu
MEMU_API_KEY=memu-dev-key
MEMU_API_URL=http://127.0.0.1:8000
# Legacy helper alias still seen in older scripts/docs: MEMU_BASE_URL

# Embeddings (Serverless API — no local ML models loaded in Gateway)
# Uses any OpenAI-compatible embedding endpoint. Change EMBEDDING_API_BASE
# to point at VoyageAI, Azure OpenAI, or a self-hosted proxy.
# L1 semantic cache: when NATS is connected, embeddings are cached in a NATS KV
# bucket (memu_embedding_cache, 24h TTL) to avoid redundant API calls.
#
# Canonical variables (use these in all deployments):
EMBEDDING_API_BASE=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
#
# Ollama override example (set all three to switch to a hosted Ollama service):
# EMBEDDING_API_BASE=http://<railway-ollama-service>.railway.internal:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMS=768
#
# EMBEDDING_BASE_URL is a deprecated alias for EMBEDDING_API_BASE.
# It is accepted for one migration window but will be removed in a future release.
# Migrate to EMBEDDING_API_BASE now.

# OpenAI (for RAG chat + hydration summarization)
OPENAI_API_KEY=

# Temporal (required only if you want /memories/async and /search/async)
TEMPORAL_HOST=
TEMPORAL_TLS=false

# Warden (container control plane)
WARDEN_SECRET=  # HMAC secret for signed respawn requests — CHANGE IN PRODUCTION
WARDEN_MAX_CONTAINERS=10
WARDEN_WARM_POOL_MODE=cold
WARDEN_GATEWAY_IMAGE=fumemory-gateway:latest

# WebSocket Bridge
WS_BRIDGE_PORT=8001

# Hardening
EVENT_RETENTION_DAYS=30
MAX_CHECKPOINTS_PER_TASK=10
HYDRATION_TIMEOUT_S=15
MEMORY_THRESHOLD_PCT=80.0

# Notion integration
NOTION_API_KEY=your-notion-integration-token
# Get from: https://www.notion.so/my-integrations

# Multi-tenancy
# Set TENANT_ID to isolate NATS subjects and Apache AGE graphs per tenant.
# Leave unset for local dev (uses global subjects, default graph).
# TENANT_ID=acme-corp

# Agent identity (for task claiming)
AGENT_ID=rosie
# rosie | lenny | macklemore | winnie | any
POLL_INTERVAL=60
# seconds between task polls

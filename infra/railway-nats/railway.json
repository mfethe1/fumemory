{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "infra/railway-nats/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -lc 'nats-server -js --store_dir /tmp/jetstream -p ${PORT:-4222} -m ${NATS_HTTP_PORT:-8222}'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fumemory.local/schemas/firecrawl-research-pack.schema.json",
  "title": "Firecrawl Research Pack",
  "type": "object",
  "required": [
    "research_pack_id",
    "topic",
    "goal",
    "mode",
    "source_urls",
    "findings",
    "constraints",
    "recommended_tasks",
    "created_at"
  ],
  "properties": {
    "research_pack_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "topic": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["search", "scrape", "crawl", "extract", "agent"] },
    "source_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "source_url"],
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "details": { "type": ["string", "null"] },
          "source_url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_tasks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_ref": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fumemory.local/schemas/swarm/gateway-registry.schema.json",
  "title": "Gateway Registry Entry",
  "type": "object",
  "required": ["gateway_id", "status", "capabilities", "last_heartbeat_at"],
  "properties": {
    "gateway_id": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["local", "cloud", "railway", "desktop", "mobile"] },
    "status": { "enum": ["online", "degraded", "offline", "draining"] },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "models": { "type": "array", "items": { "type": "string" }, "default": [] },
    "tool_access": { "type": "array", "items": { "type": "string" }, "default": [] },
    "max_concurrency": { "type": "integer", "minimum": 1, "default": 1 },
    "current_load": { "type": "number", "minimum": 0, "default": 0 },
    "trust_tier": { "enum": ["internal", "restricted"], "default": "internal" },
    "current_task_id": { "type": ["string", "null"] },
    "active_nats_node": { "enum": ["local", "railway", "standalone", null] },
    "sync_revision": { "type": "integer", "minimum": 0, "default": 0 },
    "last_heartbeat_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "default": {} }
  },
  "additionalProperties": false
}
